# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEON_DATABASE_URL: Supports both Neon Serverless PostgreSQL connection strings
# (postgresql://user:pass@ep-...neon.tech/neondb?sslmode=require) AND
# Neon Data API REST v1 endpoints (https://ep-...apirest...neon.tech/neondb/rest/v1).
NEON_DATABASE_URL="postgresql://neondb_owner:password@ep-crosx-studio.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NEON_AUTH_TOKEN: Optional Bearer JWT token when using Neon Data API (PostgREST /rest/v1).
NEON_AUTH_TOKEN=""
