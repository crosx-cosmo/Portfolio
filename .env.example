# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / NEXT_PUBLIC_SITE_URL: The canonical public URL where this platform is hosted.
APP_URL="https://crosx.in"
NEXT_PUBLIC_SITE_URL="https://crosx.in"

# NEON_DATABASE_URL: Supports both Neon Serverless PostgreSQL connection strings
# (postgresql://user:pass@ep-...neon.tech/neondb?sslmode=require) AND
# Neon Data API REST v1 endpoints (https://ep-...apirest...neon.tech/neondb/rest/v1).
NEON_DATABASE_URL="postgresql://neondb_owner:password@ep-crosx-studio.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NEON_AUTH_TOKEN: Optional Bearer JWT token when using Neon Data API (PostgREST /rest/v1).
NEON_AUTH_TOKEN=""

# ADMIN_SESSION_SECRET: Secret key used to sign HMAC-SHA256 stateless admin session cookies.
ADMIN_SESSION_SECRET=""

# ADMIN_ACCESS_TOKEN: Optional master admin access token for /admin login.
ADMIN_ACCESS_TOKEN=""
